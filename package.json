    "test": "node --test tests/*.test.mjs",
    "species": "node scripts/species.mjs"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.50.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  }
}

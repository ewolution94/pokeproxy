{
  "name": "pokeproxy",
  "private": true,
  "version": "0.1.0",
  "description": "PokeProxy: printable sheets of Pokémon card proxies at the real card size, for the binder.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/server.mjs",
